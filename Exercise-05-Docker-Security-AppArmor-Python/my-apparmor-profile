#include <tunables/global>

profile my-apparmor-profile flags=(attach_disconnected) {
    #include <abstractions/base>

    # Allow Python executable
    /usr/local/bin/python mr,

    # Allow Python runtime and shared libraries
    /usr/local/lib/python3.12/** mr,
    /usr/local/lib/python3.12/site-packages/** mr,
    /usr/lib/** mr,
    /lib/** mr,

    # Allow application files
    /app/ r,
    /app/** r,

    # Allow temporary files
    /tmp/ rw,
    /tmp/** rw,

    # Allow Flask networking
    network inet stream,

    # Deny access to sensitive files
    deny /etc/shadow r,
    deny /root/** rwklx,

    # Deny administrative capability
    deny capability sys_admin,
}
