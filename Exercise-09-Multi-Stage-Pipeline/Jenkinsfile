
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'ls -la Exercise-09-Multi-Stage-Pipeline'
            }
        }

        stage('Build') {
            steps {
                dir('Exercise-09-Multi-Stage-Pipeline') {
                    echo 'Installing dependencies...'
                    sh 'python3 -m venv venv'
                    sh './venv/bin/pip install -r requirements.txt'
                }
            }
        }

        stage('Test') {
            steps {
                dir('Exercise-09-Multi-Stage-Pipeline') {
                    echo 'Running unit tests...'
                    sh './venv/bin/python -m unittest discover -s . -p "test*.py"'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('Exercise-09-Multi-Stage-Pipeline') {
                    echo 'Deploying application...'
                    sh 'mkdir -p ../python-app-deploy'
                    sh 'cp app.py ../python-app-deploy/'
                    sh 'cp requirements.txt ../python-app-deploy/'
                }
            }
        }

        stage('Run Application') {
            steps {
                dir('Exercise-09-Multi-Stage-Pipeline') {
                    echo 'Starting Flask application...'
                    sh '''
                        cd ../python-app-deploy
                        nohup ../Exercise-09-Multi-Stage-Pipeline/venv/bin/python app.py > app.log 2>&1 &
                        echo $! > app.pid
                    '''
                }
            }
        }

        stage('Test Application') {
            steps {
                dir('Exercise-09-Multi-Stage-Pipeline') {
                    echo 'Testing deployed application...'
                    sh '''
                        ./venv/bin/python - <<'PY'
import time
import urllib.request

url = "http://127.0.0.1:5000/"
for attempt in range(15):
    try:
        with urllib.request.urlopen(url, timeout=2) as response:
            body = response.read().decode()
            assert response.status == 200
            assert body == "Hello, Jenkins Multi-Stage Pipeline!"
            print("Deployed application test passed!")
            break
    except Exception:
        if attempt == 14:
            raise
        time.sleep(1)
PY
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for details.'
        }
        always {
            dir('Exercise-09-Multi-Stage-Pipeline') {
                sh '''
                    if [ -f ../python-app-deploy/app.pid ]; then
                        kill "$(cat ../python-app-deploy/app.pid)" 2>/dev/null || true
                    fi
                '''
            }
        }
    }
}
